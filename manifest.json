{
  "manifest_version": 3,
  "name": "Read Aloud 中英朗读",
  "version": "1.0.0",
  "description": "Read Chinese and English text aloud with correct numbers, years and currency, word highlighting and speed control.",
  "action": { "default_title": "Read Aloud" },
  "side_panel": { "default_path": "index.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
